#!/sbin/openrc-run
description="Branded boot screen on tty1 until the kiosk takes over"

depend() {
	need localmount
	after devfs
}

start() {
	{
		printf '\033[2J\033[H'
		printf '\n\n\n\n\n\n\n\n\n\n\n\n'
		printf '\033[1m\033[38;2;251;83;52m%*s\033[0m\n' 44 'AIRTIME'
		printf '\033[2m%*s\033[0m\n' 46 'starting…'
	} > /dev/tty1 2>/dev/null || true
	return 0
}
