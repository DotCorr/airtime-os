#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo
read -r body
ssid=$(echo "$body" | sed -n 's/.*"ssid":"\([^"]*\)".*/\1/p')
psk=$(echo "$body" | sed -n 's/.*"psk":"\([^"]*\)".*/\1/p')
hidden=$(echo "$body" | sed -n 's/.*"hidden":\(true\|false\).*/\1/p')
extra=""
[ "$hidden" = "true" ] && extra="hidden yes"
# a stale profile for this SSID (e.g. from an earlier failed attempt) makes NM
# ignore the freshly typed password and fail with "Secrets were required" —
# always start from a clean profile
nmcli connection delete id "$ssid" >/dev/null 2>&1
if [ -n "$psk" ]; then
  out=$(nmcli --wait 30 dev wifi connect "$ssid" password "$psk" $extra 2>&1)
else
  out=$(nmcli --wait 30 dev wifi connect "$ssid" $extra 2>&1)
fi
if echo "$out" | grep -q successfully; then
  echo '{"ok":true}'
else
  err=$(echo "$out" | tail -1 | tr -d '"' | cut -c1-140)
  printf '{"ok":false,"error":"%s"}' "$err"
fi
