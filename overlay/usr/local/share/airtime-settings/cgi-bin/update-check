#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo "Access-Control-Allow-Private-Network: true"
echo "Access-Control-Allow-Headers: *"
echo
cur=$(cat /etc/airtime-release 2>/dev/null || echo dev)
latest=$(wget -qO- https://api.github.com/repos/DotCorr/airtime-os/releases/latest 2>/dev/null | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')
printf '{"current":"%s","latest":"%s"}' "$cur" "${latest:-unknown}"
