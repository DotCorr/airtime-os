#!/bin/sh
set -e

# kiosk user (uid 1000 so XDG_RUNTIME_DIR=/run/user/1000 matches the unit)
id kiosk >/dev/null 2>&1 || useradd -m -u 1000 -s /bin/bash -G video,input,audio,render kiosk

# identity: nothing on this machine should say "debian" to a user
echo airtimeos > /etc/hostname
hostnamectl set-hostname airtimeos 2>/dev/null || true
: > /etc/motd
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="AirtimeOS"/; s/^NAME=.*/NAME="AirtimeOS"/; s/^ID=.*/ID=airtimeos/; s/^HOME_URL=.*/HOME_URL="https:\/\/airtime.dotcorr.com"/' /etc/os-release 2>/dev/null || true

# branded boot splash, no text
plymouth-set-default-theme airtime

# our services
systemctl enable airtime-settingsd.service
systemctl enable airtime-wifi-driver.service
systemctl enable lightdm.service
# lightdm owns the graphical session now
systemctl disable airtime-kiosk.service 2>/dev/null || true
rm -f /etc/systemd/system/airtime-kiosk.service
# the kiosk user must own its own session dir
chown -R kiosk:kiosk /home/kiosk
# Ctrl+Alt+F2 gives a root console (ad screens have no keyboard; this is for
# field diagnosis and is what makes a black screen debuggable)
systemctl enable getty@tty2.service
# serial console for diagnosis; systemd BindsTo the device, so this never
# starts on machines without a real UART (laptops, Macs) — no boot risk
systemctl enable serial-getty@ttyS0.service
systemctl set-default graphical.target

# nothing on the console but our splash
systemctl disable getty@tty1.service 2>/dev/null || true
systemctl mask systemd-ask-password-plymouth.service 2>/dev/null || true

# NetworkManager owns all interfaces (no ifupdown fighting it)
printf '[main]\nplugins=keyfile\n\n[ifupdown]\nmanaged=true\n' > /etc/NetworkManager/NetworkManager.conf

# regenerate initramfs so plymouth + firmware are present at early boot
# ship ALL firmware in the initramfs — GPU drivers load before the root
# filesystem is mounted, so firmware that lives only on disk arrives too late
echo 'FRAMEBUFFER=y' > /etc/initramfs-tools/conf.d/airtime-splash
sed -i 's/^MODULES=.*/MODULES=most/' /etc/initramfs-tools/initramfs.conf
update-initramfs -u -k all
