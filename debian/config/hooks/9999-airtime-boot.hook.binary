#!/bin/sh
# Own the bootloaders: no menus, no waiting, no Debian branding.
# Runs in the binary stage, where the ISO tree lives in ./binary
set -e

APPEND="boot=live components quiet splash persistence noeject"

# BIOS path (isolinux): default config is "timeout 0" = wait forever.
if [ -d binary/isolinux ]; then
	cat > binary/isolinux/isolinux.cfg <<ISO
default airtime
prompt 0
timeout 1

label airtime
  kernel /live/vmlinuz
  append initrd=/live/initrd.img $APPEND
ISO
fi

# EFI path (grub) — this is what Macs and modern PCs use.
if [ -d binary/boot/grub ]; then
	cat > binary/boot/grub/grub.cfg <<GRUB
set timeout=0
set timeout_style=hidden
set default=0

menuentry "AirtimeOS" {
	linux	/live/vmlinuz $APPEND
	initrd	/live/initrd.img
}
GRUB
	rm -f binary/boot/grub/config.cfg binary/boot/grub/theme.cfg 2>/dev/null || true
fi
