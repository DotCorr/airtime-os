#!/bin/sh
# The Airtime kiosk session: Chromium fullscreen on X, forever.
#
# X rather than Wayland, deliberately. This machine ships to unknown hardware in
# shops and gyms, so the priority is "always shows a picture" over "modern".
# Xorg degrades through the proper driver, modesetting, framebuffer and finally
# VESA; a strict Wayland compositor gives a black screen instead. Xorg also has
# xrandr, so we can put the panel in its native mode — which Wayland kiosks
# cannot do without the output-management protocol.
set -u

APP_URL="$(cat /etc/airtime/screen.conf 2>/dev/null || echo 'https://airtime.dotcorr.com/tv')"
SETTINGS_URL="http://localhost:8800"

chromium_flags="--kiosk --no-first-run --noerrdialogs --disable-infobars \
  --disable-session-crashed-bubble --autoplay-policy=no-user-gesture-required \
  --disable-pinch --overscroll-history-navigation=0 \
  --check-for-update-interval=31536000 \
  --default-background-color=FF000000"

# In a VM there is no real GPU; keep the debugging port open there too.
if grep -qi hypervisor /proc/cpuinfo; then
  chromium_flags="$chromium_flags --remote-debugging-port=9222 --remote-allow-origins=*"
fi

cat > /tmp/airtime-xsession <<'XSESSION'
#!/bin/sh
# no screen blanking, no power management: this screen must stay lit
xset s off -dpms s noblank 2>/dev/null || true
# put the panel in its native (preferred) mode — the fix for letterboxed,
# blurry output when firmware leaves a fallback mode behind
out=$(xrandr | awk '/ connected/ {print $1; exit}')
[ -n "$out" ] && xrandr --output "$out" --auto 2>/dev/null || true
xrandr > /tmp/airtime-display.txt 2>&1
# hide the pointer on an ad screen; it reappears on movement
unclutter -idle 1 -root >/dev/null 2>&1 &
# a tiny window manager makes fullscreen reliable across drivers
matchbox-window-manager -use_titlebar no -use_cursor no >/dev/null 2>&1 &
exec "$@"
XSESSION
chmod +x /tmp/airtime-xsession

fails=0
while true; do
  started=$(date +%s)
  boot="$SETTINGS_URL/boot.html#$APP_URL|$SETTINGS_URL"
  xinit /tmp/airtime-xsession /usr/bin/chromium $chromium_flags "$boot" \
    -- :0 vt1 -nolisten tcp -keeptty >>/tmp/kiosk.log 2>&1

  if [ $(( $(date +%s) - started )) -lt 8 ]; then
    fails=$((fails + 1))
  else
    fails=0
  fi
  if [ "$fails" -ge 3 ]; then
    {
      printf '\033[2J\033[H\n\n\n\n\n\n\n\n'
      printf '\033[1m\033[38;2;251;83;52m%*s\033[0m\n\n' 46 'AIRTIME'
      printf '%*s\n\n' 60 'This display adapter is not supported yet.'
      printf '\033[2m%*s\033[0m\n' 66 'Details: /tmp/kiosk.log  (console: Ctrl+Alt+F2, user root)'
    } > /dev/tty1 2>/dev/null || true
    sleep 20
  fi
  sleep 2
done
