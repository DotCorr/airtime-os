#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo "Access-Control-Allow-Private-Network: true"
echo "Access-Control-Allow-Headers: *"
echo
read -r body
dec() { "$(command -v busybox-extras || command -v busybox)" httpd -d "$1" 2>/dev/null || printf '%s' "$1"; }
val() { printf '%s\n' "$body" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1; }
ssid=$(dec "$(val ssid)")
psk=$(dec "$(val psk)")
hidden=$(val hidden)
[ -z "$ssid" ] && { echo '{"ok":false,"error":"no ssid"}'; exit 0; }

# No adapter at all: answer with the real cause instead of running the whole
# association ladder and reporting whatever error falls out of the end of it.
if ! ls /sys/class/net/*/phy80211 >/dev/null 2>&1; then
  reason=$(sed -n "s/^reason: //p" /run/airtime-wifi-driver 2>/dev/null | tail -1)
  [ -z "$reason" ] && reason="This machine has no usable Wi-Fi adapter. Plug in Ethernet, or a USB Wi-Fi adapter."
  reason=$(printf '%s' "$reason" | tr -d '"\\')
  printf '{"ok":false,"error":"no wireless adapter","hint":"%s","visible":0,"psk_len":%s}' "$reason" "${#psk}"
  exit 0
fi

# radio on and unblocked — a blocked radio looks exactly like "no networks"
rfkill unblock wifi >/dev/null 2>&1
rfkill unblock all  >/dev/null 2>&1
nmcli radio wifi on >/dev/null 2>&1

# NetworkManager answers "network could not be found" from its *cached* scan.
# Force fresh scans until the SSID appears (routers on 5 GHz and busy bands
# routinely need more than one sweep).
# nmcli escapes a colon inside a network name as "\:". The old matcher deleted
# that colon rather than unescaping it, so "Cafe: Free" was compared as
# "Cafe Free" and never matched — reported to the owner as "the Wi-Fi network
# could not be found" with the network plainly visible in the list.
list_ssids() {
  nmcli -t -f SSID dev wifi list 2>/dev/null | sed 's/\\:/:/g; s/\\\\/\\/g'
}

seen=no
i=0
while [ "$i" -lt 4 ]; do
  nmcli device wifi rescan >/dev/null 2>&1
  sleep 3
  if list_ssids | grep -qxF "$ssid"; then
    seen=yes
    break
  fi
  i=$((i + 1))
done
visible=$(list_ssids | grep -c .)

# not in any scan → it is either hidden or out of range; try hidden explicitly
hf=""
[ "$hidden" = "1" ] && hf="hidden yes"
[ "$seen" = "no" ] && hf="hidden yes"

try_std() {
  nmcli connection delete id "$ssid" >/dev/null 2>&1
  if [ -n "$psk" ]; then
    nmcli --wait 45 dev wifi connect "$ssid" password "$psk" $hf 2>&1
  else
    nmcli --wait 45 dev wifi connect "$ssid" $hf 2>&1
  fi
}
try_keymgmt() {
  hp=""
  [ -n "$hf" ] && hp="802-11-wireless.hidden yes"
  nmcli connection delete id "$ssid" >/dev/null 2>&1
  nmcli connection add type wifi con-name "$ssid" ssid "$ssid" \
    wifi-sec.key-mgmt "$1" wifi-sec.psk "$psk" $hp >/dev/null 2>&1
  nmcli --wait 45 connection up id "$ssid" 2>&1
}

# Some routers (and Apple's Broadcom adapters) fail the default negotiation:
# protected-management-frames mismatch, or a randomised MAC the router rejects.
# Walk every combination rather than declaring the password wrong.
try_hard() {
  hp=""
  [ -n "$hf" ] && hp="802-11-wireless.hidden yes"
  nmcli connection delete id "$ssid" >/dev/null 2>&1
  nmcli connection add type wifi con-name "$ssid" ssid "$ssid" \
    wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$psk" \
    wifi-sec.pmf "$1" 802-11-wireless.cloned-mac-address permanent \
    802-11-wireless.powersave 2 ipv4.dhcp-timeout 45 $hp >/dev/null 2>&1
  nmcli --wait 45 connection up id "$ssid" 2>&1
}

# "the base network connection was interrupted" means the link came up and then
# died mid-handshake. On a laptop the usual causes are the radio's power saving
# cutting the association, and band steering handing us a 5 GHz or DFS channel
# the card cannot hold. Pinning the band and disabling power saving addresses
# both, and is worth trying before telling anyone their password is wrong.
try_band() {
  hp=""
  [ -n "$hf" ] && hp="802-11-wireless.hidden yes"
  nmcli connection delete id "$ssid" >/dev/null 2>&1
  nmcli connection add type wifi con-name "$ssid" ssid "$ssid" \
    wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$psk" \
    802-11-wireless.band "$1" 802-11-wireless.powersave 2 \
    802-11-wireless.cloned-mac-address permanent ipv4.dhcp-timeout 45 $hp >/dev/null 2>&1
  nmcli --wait 45 connection up id "$ssid" 2>&1
}

out=$(try_std)
if ! echo "$out" | grep -q successfully && [ -n "$psk" ]; then
  out=$(try_keymgmt wpa-psk)
  echo "$out" | grep -q successfully || out=$(try_keymgmt sae)
  echo "$out" | grep -q successfully || out=$(try_hard 1)   # PMF disabled
  echo "$out" | grep -q successfully || out=$(try_hard 3)   # PMF required
  # 2.4 GHz last: slower, but it reaches further and survives interference that
  # kills a 5 GHz association outright.
  echo "$out" | grep -q successfully || out=$(try_band a)
  echo "$out" | grep -q successfully || out=$(try_band bg)
fi

if echo "$out" | grep -q successfully; then
  echo '{"ok":true}'
  exit 0
fi

nmcli connection delete id "$ssid" >/dev/null 2>&1
err=$(printf '%s\n' "$out" | grep -m1 -i "^Error:" | sed 's/^[Ee]rror: *//')
[ -z "$err" ] && err=$(printf '%s\n' "$out" | grep -vi "^Hint:" | grep -v '^$' | tail -1)

# Match the ACTUAL error only — never the journal, and check "not found"
# before password causes, or a missing network reads as a bad password.
low=$(printf '%s' "$err" | tr 'A-Z' 'a-z')
case "$low" in
  *"could not be found"*|*"no network with ssid"*|*"not found"*)
      if [ "$visible" -eq 0 ]; then
        hint="This screen cannot see any Wi-Fi networks. Check the router is on and in range."
      else
        hint="That network was not found. It may be out of range, or on a band this machine cannot see. Try Rescan, or use Join hidden network."
      fi ;;
  *"secrets were required"*|*"invalid password"*|*"802-11-wireless-security"*|*"key management"*)
      hint="Wrong Wi-Fi password." ;;
  *"interrupted"*|*"deactivated"*|*"disconnected"*)
      hint="The screen reached that network but the connection dropped during setup. This is usually interference or distance, not the password — move the screen closer to the router and try again." ;;
  *"timeout"*|*"timed out"*|*"took too long"*)
      hint="The router did not answer in time. Try again, or move the screen closer." ;;
  *"blocked"*|*"rfkill"*)
      hint="The Wi-Fi radio is switched off in hardware." ;;
  *"no wi-fi device"*|*"no suitable device"*|*"device not found"*)
      hint="No Wi-Fi adapter was detected on this machine." ;;
  *) hint="" ;;
esac
err=$(printf '%s' "$err" | tr -d '"\\' | cut -c1-160)
hint=$(printf '%s' "$hint" | tr -d '"\\')
printf '{"ok":false,"error":"%s","hint":"%s","visible":%s,"psk_len":%s}' \
  "$err" "$hint" "${visible:-0}" "${#psk}"
