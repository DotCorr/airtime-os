#!/bin/sh
# The kiosk session: Cage compositor running Chromium fullscreen, forever.
# No network → local settings page first. Chromium dies → it respawns.
set -u

# Wayland compositors need a runtime dir; there's no systemd-logind to make one.
export XDG_RUNTIME_DIR="/tmp/xdg-runtime-$(id -u)"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

# GPUs without 3D accel (VMs, some thin clients) fall back to software rendering;
# wlroots refuses that without explicit opt-in. Hardware GL is still preferred.
export WLR_RENDERER_ALLOW_SOFTWARE=1
export WLR_NO_HARDWARE_CURSORS=1

SETTINGS_URL="http://localhost:8800"
APP_URL="$(cat /etc/airtime/screen.conf 2>/dev/null || echo 'https://airtime.dotcorr.com/tv')"

# local settings daemon (Wi-Fi setup UI)
pgrep -f airtime-settingsd >/dev/null || /usr/local/bin/airtime-settingsd &

chromium_flags="--kiosk --no-first-run --noerrdialogs --disable-infobars \
  --disable-session-crashed-bubble --autoplay-policy=no-user-gesture-required \
  --enable-features=VaapiVideoDecoder --ozone-platform=wayland \
  --disable-pinch --overscroll-history-navigation=0"

# VMs have no real GPU: force cage's pixman renderer (the GL-on-llvmpipe path
# stalls frame presentation under emulation), run Chromium fully in software,
# and keep the CDP port open for headless debugging/screenshots.
if grep -qi hypervisor /proc/cpuinfo; then
  export WLR_RENDERER=pixman
  # --disable-software-rasterizer with --disable-gpu skips ALL GL init attempts:
  # without it the GPU process crash-loops on SwANGLE and kills the first
  # renderer, leaving kiosk mode stuck on an unrecovered blank tab.
  chromium_flags="$chromium_flags --disable-gpu --disable-software-rasterizer --remote-debugging-port=9222 --remote-allow-origins=*"
fi

while true; do
  # The first session after cold boot sometimes wedges its renderer before
  # parsing anything (races the still-settling system); a bounced session
  # reliably recovers. Watchdog: no page title after 4 min => bounce.
  if grep -qi hypervisor /proc/cpuinfo; then
    (
      sleep 240
      if wget -qO- http://127.0.0.1:9222/json 2>/dev/null | grep -q '"title": ""'; then
        pkill chromium
      fi
    ) &
  fi
  # Launch straight into the local bootstrap trampoline — no network probe
  # gating startup. boot.html retries the app until reachable and falls back
  # to the Wi-Fi settings page itself when the network never comes up.
  boot="$SETTINGS_URL/boot.html#$APP_URL|$SETTINGS_URL"
  # wvkbd only if a touchscreen exists
  if grep -qi touch /proc/bus/input/devices 2>/dev/null; then
    cage -- sh -c "wvkbd-mobintl -L 220 --hidden & chromium $chromium_flags '$boot'" \
      >>/tmp/kiosk.log 2>&1
  else
    cage -- chromium $chromium_flags "$boot" >>/tmp/kiosk.log 2>&1
  fi
  sleep 2 # crashed or exited — respawn
done
