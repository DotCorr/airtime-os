#!/bin/sh
echo "Content-Type: application/json"
echo "Access-Control-Allow-Origin: *"
echo
log=$(tail -c 600 /tmp/airtime-install.log 2>/dev/null | tr '"' "'" | tr '\n' ' ')
running=false
[ -f /tmp/airtime-install.pid ] && kill -0 "$(cat /tmp/airtime-install.pid)" 2>/dev/null && running=true
done=false; grep -q AIRTIME_INSTALL_DONE /tmp/airtime-install.log 2>/dev/null && done=true
printf '{"running":%s,"done":%s,"log":"%s"}' "$running" "$done" "$log"
