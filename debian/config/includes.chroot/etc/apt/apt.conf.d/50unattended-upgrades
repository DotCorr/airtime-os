// Security patches only. Not stable-updates, not backports, and never a
// distribution upgrade: this machine's job is to keep showing ads, and the
// only changes worth taking unattended are the ones that close holes.
// Debian's stock config writes ${distro_codename} here. We rewrote
// /etc/os-release to say AirtimeOS, and if that variable ever resolves to
// anything but "trixie" this pattern matches nothing and the machine silently
// stops patching itself while still reporting success -- the worst possible
// failure for a security mechanism. The distribution is pinned at build time,
// so name it, and keep a suite-based pattern alongside as a second route.
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=trixie-security,label=Debian-Security";
        "origin=Debian,archive=stable-security,label=Debian-Security";
};

// Never reboot on its own -- a screen restarting mid-booking is worse than a
// screen running last week's kernel. The settings panel surfaces the need.
Unattended-Upgrade::Automatic-Reboot "false";

// Nothing here can answer a prompt, so a package asking about a config file
// must keep the version we shipped rather than block forever.
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Dpkg::Options {
   "--force-confdef";
   "--force-confold";
};

// no mail on an appliance
Unattended-Upgrade::Mail "";
