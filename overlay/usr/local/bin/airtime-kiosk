#!/bin/sh
# The kiosk session: Cage compositor running Chromium fullscreen, forever.
# No network → local settings page first. Chromium dies → it respawns.
set -u

# Wayland compositors need a runtime dir; there's no systemd-logind to make one.
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "${XDG_RUNTIME_DIR:-}" ]; then
  export XDG_RUNTIME_DIR="/tmp/xdg-runtime-$(id -u)"
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
fi

# GPUs without 3D accel (VMs, some thin clients) fall back to software rendering;
# wlroots refuses that without explicit opt-in. Hardware GL is still preferred.
export WLR_RENDERER_ALLOW_SOFTWARE=1

SETTINGS_URL="http://localhost:8800"
APP_URL="$(cat /etc/airtime/screen.conf 2>/dev/null || echo 'https://airtime.dotcorr.com/tv')"

chromium_flags="--kiosk --no-first-run --noerrdialogs --disable-infobars \
  --disable-session-crashed-bubble --autoplay-policy=no-user-gesture-required \
  --enable-features=VaapiVideoDecoder --ozone-platform=wayland \
  --disable-pinch --overscroll-history-navigation=0 \
  --default-background-color=FF000000"

# VMs have no real GPU: force cage's pixman renderer (the GL-on-llvmpipe path
# stalls frame presentation under emulation), run Chromium fully in software,
# and keep the CDP port open for headless debugging/screenshots.
if grep -qi hypervisor /proc/cpuinfo; then
  export WLR_RENDERER=pixman
  # no hardware cursor plane under emulation; on real GPUs the hardware cursor
  # avoids full-screen repaints (which showed as stutter and artifacts)
  export WLR_NO_HARDWARE_CURSORS=1
  chromium_flags="$chromium_flags --remote-debugging-port=9222 --remote-allow-origins=*"
  # Alpine ships a Chromium whose GPU process crash-loops on SwANGLE in VMs, so
  # there we must switch GL off entirely. Debian renders NOTHING with those same
  # flags (mesa software GL is the only path that paints) — hence the split.
  if [ -f /etc/alpine-release ]; then
    chromium_flags="$chromium_flags --disable-gpu --disable-software-rasterizer"
  fi
fi

# Plymouth holds DRM master while its splash is up. If it has not released the
# display by the time we start, the compositor cannot open any GPU and the
# screen stays on the logo forever — tell it to quit before we try.
if command -v plymouth >/dev/null 2>&1; then
  plymouth quit >/dev/null 2>&1 || true
  sleep 1
fi

fails=0
while true; do
  # The first session after cold boot sometimes wedges its renderer before
  # parsing anything (races the still-settling system); a bounced session
  # reliably recovers. Watchdog: no page title after 4 min => bounce.
  if grep -qi hypervisor /proc/cpuinfo; then
    (
      sleep 240
      if { command -v wget >/dev/null && wget -qO- http://127.0.0.1:9222/json 2>/dev/null || curl -s http://127.0.0.1:9222/json 2>/dev/null; } | grep -q '"title": ""'; then
        pkill chromium
      fi
    ) &
  fi
  # Launch straight into the local bootstrap trampoline — no network probe
  # gating startup. boot.html retries the app until reachable and falls back
  # to the Wi-Fi settings page itself when the network never comes up.
  boot="$SETTINGS_URL/boot.html#$APP_URL|$SETTINGS_URL"
  started=$(date +%s)
  # Force the panel to its native (preferred) mode before painting. Without
  # this the compositor accepts whatever the firmware left behind, which on
  # laptops is often a low, wrong-aspect fallback: letterboxed and blurry.
  cage -- sh -c '''
    if command -v wlr-randr >/dev/null 2>&1; then
      out=$(wlr-randr 2>/dev/null | awk "/^[A-Za-z0-9]/ {print \$1; exit}")
      mode=$(wlr-randr 2>/dev/null | awk "/preferred/ {print \$1; exit}")
      [ -n "$out" ] && [ -n "$mode" ] && wlr-randr --output "$out" --mode "$mode" >/dev/null 2>&1
      wlr-randr >/tmp/airtime-display.txt 2>&1
    fi
    exec chromium '"$chromium_flags"' "'"$boot"'"
  ''' >>/tmp/kiosk.log 2>&1
  # A session that dies within seconds means the compositor can't drive the
  # display adapter at all — tell the human instead of failing silently.
  if [ $(( $(date +%s) - started )) -lt 8 ]; then
    fails=$((fails + 1))
  else
    fails=0
  fi
  # The compositor could not drive this GPU twice in a row. Rather than leave a
  # customer looking at a logo, run the same browser under X, which falls back
  # through modesetting, framebuffer and VESA.
  if [ "$fails" -ge 2 ] && command -v xinit >/dev/null 2>&1; then
    {
      printf '\033[2J\033[H\n\n\n\n'
      printf '\033[1m\033[38;2;251;83;52m%*s\033[0m\n\n' 46 'AIRTIME'
      printf '%*s\n' 58 'starting in compatibility mode...'
    } > /dev/tty1 2>/dev/null || true
    x_flags=$(printf '%s' "$chromium_flags" | sed 's/--ozone-platform=wayland//')
    xinit /usr/bin/chromium $x_flags "$boot" -- :0 vt1 -nolisten tcp -keeptty >>/tmp/kiosk.log 2>&1
    sleep 2
    continue
  fi

  if [ "$fails" -ge 3 ]; then
    {
      printf '\033[2J\033[H\n\n\n\n\n\n\n\n'
      printf '\033[1m\033[38;2;251;83;52m%*s\033[0m\n\n' 46 'AIRTIME'
      printf '%*s\n\n' 62 'This display adapter is not supported yet.'
      printf '%*s\n' 74 'VirtualBox: Settings > Display > Graphics Controller = VMSVGA,'
      printf '%*s\n\n' 52 '3D acceleration OFF, then restart.'
      printf '\033[2m%*s\033[0m\n' 66 'Details: /tmp/kiosk.log  (serial console login: root)'
    } > /dev/tty1 2>/dev/null || true
    sleep 20
  fi
  sleep 2 # crashed or exited — respawn
done
