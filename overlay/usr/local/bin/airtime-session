#!/bin/sh
# The Airtime session, run by the display manager exactly like a desktop
# session. LightDM has already dealt with the VT, X, permissions and the seat —
# all the things that go wrong when you try to do it by hand.
set -u

APP_URL="$(cat /etc/airtime/screen.conf 2>/dev/null || echo 'https://airtime.dotcorr.com/tv')"
SETTINGS_URL="http://localhost:8800"

# never blank, never sleep: this is a shop screen
xset s off -dpms s noblank 2>/dev/null || true
# native panel mode — the fix for letterboxed, blurry output
out=$(xrandr 2>/dev/null | awk '/ connected/ {print $1; exit}')
[ -n "$out" ] && xrandr --output "$out" --auto 2>/dev/null || true
# Brightness, rotation and anything else the venue has set. Applied here rather
# than by a service because it needs X, and applied on every session start so a
# screen that lost power comes back looking exactly as it was left.
/usr/local/bin/airtime-display apply 2>/dev/null || true
xrandr > /tmp/airtime-display.txt 2>&1
unclutter -idle 1 -root >/dev/null 2>&1 &
matchbox-window-manager -use_titlebar no -use_cursor no >/dev/null 2>&1 &

flags="--kiosk --no-first-run --noerrdialogs --disable-infobars \
  --disable-session-crashed-bubble --autoplay-policy=no-user-gesture-required \
  --disable-pinch --overscroll-history-navigation=0 \
  --check-for-update-interval=31536000 --password-store=basic \
  --default-background-color=FF000000"
grep -qi hypervisor /proc/cpuinfo && flags="$flags --remote-debugging-port=9222 --remote-allow-origins=*"

# Chromium dies -> bring it straight back; the session itself is supervised by
# the display manager, so we never re-implement session recovery either.
#
# Language is resolved *inside* the loop (files only — manual choice, then the
# cached geo-IP detection, then English; never the network) so that applying a
# new language from the settings panel is nothing more than ending the browser:
# the respawn relaunches it with the new --lang, exactly how updates already
# restart the session. The web app reads navigator.languages, so these two
# flags are all the wiring the whole screen needs.
while true; do
  lang=$(/usr/local/bin/airtime-lang resolve 2>/dev/null || echo en)
  chromium $flags --lang="$lang" --accept-lang="$lang,en" \
    "$SETTINGS_URL/boot.html#$APP_URL|$SETTINGS_URL" >>/tmp/kiosk.log 2>&1
  sleep 2
done
